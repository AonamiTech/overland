# The public Supabase URL and anon key are intentionally defined in
# src/auth/supabaseConfig.ts so deployments use the same production backend
# without build-time auth variables. Never place a service_role key in client code.

# EIA (US Energy Information Administration) — powers the real diesel figure.
# Server-side only; never prefix with VITE_ or it lands in the client bundle.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Sentry DSN for error monitoring. Safe to expose in the bundle (write-only ingest key).
# Leave blank in development/local mode to keep Sentry silent.
VITE_SENTRY_DSN=
