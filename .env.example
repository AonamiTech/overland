# Leave these unset to run in LOCAL mode (no email is sent; sign-in is immediate).
# Set both to switch to real magic-link email via Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EIA (US Energy Information Administration) — powers the real diesel figure.
# Server-side only; never prefix with VITE_ or it lands in the client bundle.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
