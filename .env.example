# Leave these unset to run in LOCAL mode (no email is sent; sign-in is immediate).
# Set both to switch to real magic-link email via Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional while the Supabase Google provider is being configured.
# Set to "off" to hide the Google button without changing the email flow.
VITE_GOOGLE_AUTH=

# EIA (US Energy Information Administration) — powers the real diesel figure.
# Server-side only; never prefix with VITE_ or it lands in the client bundle.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Sentry DSN for error monitoring. Safe to expose in the bundle (write-only ingest key).
# Leave blank in development/local mode to keep Sentry silent.
VITE_SENTRY_DSN=
